{
  "name": "openuse",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first, AI-agnostic Computer Use runtime for macOS and Windows.",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @openuse/desktop dev",
    "dev:qualify": "pnpm --filter @openuse/desktop dev:qualify",
    "build": "pnpm --filter @openuse/desktop build",
    "desktop:build": "pnpm --filter @openuse/desktop build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "native:build": "dotnet publish native/windows/OpenUse.WindowsController.csproj -c Release -r win-x64 --self-contained false -o native/windows/publish",
    "native:test": "dotnet test native/windows.tests/OpenUse.WindowsController.Tests.csproj",
    "native:build:macos": "swift build --package-path native/macos -c release",
    "native:test:macos": "swift run --package-path native/macos -c debug OpenUseMacProtocolTests",
    "test:windows": "pnpm native:build && pnpm native:test && pnpm --filter @openuse/desktop test:windows",
    "test:macos": "pnpm native:build:macos && pnpm native:test:macos && pnpm --filter @openuse/desktop test:macos",
    "test:qualification": "node scripts/check-qualification.mjs",
    "setup:windows": "node scripts/setup-windows.mjs",
    "verify:windows": "node scripts/verify-windows.mjs",
    "qualify:windows": "node scripts/qualify-windows.mjs",
    "setup:macos": "node scripts/setup-macos.mjs",
    "verify:macos": "node scripts/verify-macos.mjs",
    "qualify:macos": "node scripts/qualify-macos.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.18.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.20.0"
  }
}
